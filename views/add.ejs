<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f3efe7">
  <title><%= title %> · Taskboard</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('navbar') %>
  <main class="wrap">
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <div class="page-head">
      <div>
        <h1>New task</h1>
        <p class="lead">Give it a title, a priority, and an optional due date.</p>
      </div>
    </div>
    <form class="panel" method="post" action="/add" autocomplete="off">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <div class="field">
        <label for="title">Title</label>
        <input id="title" name="title" type="text" maxlength="120" autofocus value="<%= values.title %>" class="<%= errors.title ? 'is-invalid' : '' %>" placeholder="What needs doing?">
        <% if (errors.title) { %><p class="err"><%= errors.title %></p><% } %>
      </div>
      <div class="field">
        <label for="description">Description</label>
        <textarea id="description" name="description" maxlength="1000" rows="4" placeholder="Optional details" class="<%= errors.description ? 'is-invalid' : '' %>"><%= values.description %></textarea>
        <% if (errors.description) { %><p class="err"><%= errors.description %></p><% } %>
      </div>
      <div class="pair">
        <div class="field">
          <label for="priority">Priority</label>
          <select id="priority" name="priority" class="<%= errors.priority ? 'is-invalid' : '' %>">
            <option value="low" <%= values.priority === 'low' ? 'selected' : '' %>>Low</option>
            <option value="medium" <%= values.priority === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="high" <%= values.priority === 'high' ? 'selected' : '' %>>High</option>
          </select>
          <% if (errors.priority) { %><p class="err"><%= errors.priority %></p><% } %>
        </div>
        <div class="field">
          <label for="dueDate">Due date</label>
          <input id="dueDate" name="dueDate" type="date" value="<%= values.dueDate %>" class="<%= errors.dueDate ? 'is-invalid' : '' %>">
          <% if (errors.dueDate) { %><p class="err"><%= errors.dueDate %></p><% } %>
        </div>
      </div>
      <div class="actions">
        <button class="btn" type="submit">Add task</button>
        <a class="btn secondary" href="<%= returnTo %>">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
